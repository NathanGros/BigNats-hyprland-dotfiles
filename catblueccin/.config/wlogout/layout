{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "l"
}

{
    "label" : "logout",
    "action" : "hyprshutdown -t 'Logging out...'",
    "keybind" : "e"
}

{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "keybind" : "p"
}

{
    "label" : "shutdown",
    "action" : "hyprshutdown -t 'Shutting down...' --post-cmd 'systemctl poweroff'",
    "keybind" : "s"
}

{
    "label" : "reboot",
    "action" : "hyprshutdown -t 'Rebooting...' --post-cmd 'systemctl reboot'",
    "keybind" : "r"
}
